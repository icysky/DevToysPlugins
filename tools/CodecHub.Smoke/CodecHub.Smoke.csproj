<Project Sdk="Microsoft.NET.Sdk">

  <!--
    编码 / 进制逻辑回归冒烟：只链接 Core 源码（不依赖 DevToys.Api，可独立运行）。
    运行：dotnet run -p tools/CodecHub.Smoke/CodecHub.Smoke.csproj
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- 与 DevToys 宿主的 .NET 8 运行时保持一致，顺带当 API 可用性门禁 -->
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CodecHub.DevToys</RootNamespace>
    <AssemblyName>CodecHub.Smoke</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\CodecHub.DevToys\Core\**\*.cs"
             Exclude="..\..\src\CodecHub.DevToys\bin\**\*.cs;..\..\src\CodecHub.DevToys\obj\**\*.cs"
             LinkBase="Core" />
  </ItemGroup>

</Project>
