<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      必须按 net8.0 编译：DevToys 2.0.9-preview 宿主是自包含 .NET 8（includedFrameworks 8.0.x）。
      按 net10.0 编译会引用 System.Runtime.Numerics 10.0.0.0 这类真实框架程序集，
      加载时抛 ReflectionTypeLoadException，扩展列表可见但工具不出现（详见仓库根 README 坑 1）。
      注意 BCL 差异：X509CertificateLoader 是 .NET 9+ API，本工程用 #if NET10_0_OR_GREATER 保留了回落分支。
    -->
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MyCert.DevToys</RootNamespace>
    <AssemblyName>MyCert.DevToys</AssemblyName>
    <!-- DevToys 扩展元数据 -->
    <IsPackable>true</IsPackable>
    <Version>1.0.0.3</Version>
    <Title>DevToys Certificate Generator</Title>
    <Description>Generate test X.509 certificates (RSA / SM2) for OFD signing, HTTPS and code signing.</Description>
    <Authors>MyCert</Authors>
    <PackageTags>devtoys-app</PackageTags>
    <PackageId>MyCert.DevToys</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- 由下方 IncludeAllFilesInTargetDir 统一打包，避免默认 build output 与自定义 lib 重复 -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- 许可证 / 仓库地址 / 版权统一在仓库根 Directory.Build.props 里声明 -->
    <!-- MEF 依赖通过反射加载，禁止 trimming -->
    <PublishTrimmed>false</PublishTrimmed>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <!-- 宿主已自带 DevToys.Api 与 MEF 程序集，只编译引用，不复制到插件输出 -->
    <PackageReference Include="DevToys.Api" Version="2.0.9-preview" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="System.ComponentModel.Composition" Version="8.0.0" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
  </ItemGroup>
  <ItemGroup>
    <!--
      证书生成实现已内联到本工程的 CertGen\ 目录（SDK 默认 glob 会编译它），
      不再从 ..\TestCertGenerator\CertGen 链接，避免跨仓库相对路径。
      注意：MyCert WPF 版（E:\NewProjects\OFD\MyCert）仍使用它自己那份 TestCertGenerator\CertGen，
      两处再修改时需要手动同步。
    -->
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <!-- DevToys 扩展包：把插件自身及运行时依赖（BouncyCastle）全部放进 lib/<TFM> -->
  <Target Name="IncludeAllFilesInTargetDir" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <None Include="$(OutputPath)\**">
        <Pack>true</Pack>
        <PackagePath>lib\$(TargetFramework)</PackagePath>
      </None>
    </ItemGroup>
  </Target>
</Project>