<Window x:Class="ColorSchemer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ColorSchemer.Controls"
        Title="ColorSchemer"
        Width="1280" Height="840"
        MinWidth="1040" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="13"
        Foreground="{StaticResource TextPrimary}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部标题与全局操作 -->
        <Grid Grid.Row="0" Margin="4,0,4,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="ColorSchemer" FontSize="22" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}" />
                <TextBlock Text="取色 · 配色 · 色板" Margin="12,7,0,0"
                           Foreground="{StaticResource TextSecondary}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="屏幕取色" Style="{StaticResource PrimaryButton}"
                        Click="OnPickScreen" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- 左：基色与通道 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="基色 Base Color" Style="{StaticResource SectionTitle}" />

                        <Border x:Name="BasePreview" Height="110" CornerRadius="8"
                                BorderBrush="#22000000" BorderThickness="1"
                                MouseLeftButtonDown="OnCopyHex"
                                ToolTip="点击复制 HEX" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="HEX" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondary}" />
                            <TextBox x:Name="HexBox" Grid.Column="1"
                                     FontFamily="Consolas" FontSize="14"
                                     Padding="6,4" VerticalContentAlignment="Center"
                                     KeyDown="OnHexKeyDown" LostFocus="OnHexLostFocus" />
                        </Grid>

                        <TextBlock Text="RGB" Margin="0,14,0,2" Style="{StaticResource Hint}" />

                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="R" VerticalAlignment="Center" Foreground="#EF4444" />
                            <Slider x:Name="RSlider" Grid.Column="1" Minimum="0" Maximum="255"
                                    TickFrequency="1" ValueChanged="OnRgbSliderChanged" />
                            <TextBox x:Name="RBox" Grid.Column="2" Style="{StaticResource MiniTextBox}"
                                     KeyDown="OnRgbBoxKeyDown" LostFocus="OnRgbBoxLostFocus" />
                        </Grid>

                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="G" VerticalAlignment="Center" Foreground="#22C55E" />
                            <Slider x:Name="GSlider" Grid.Column="1" Minimum="0" Maximum="255"
                                    TickFrequency="1" ValueChanged="OnRgbSliderChanged" />
                            <TextBox x:Name="GBox" Grid.Column="2" Style="{StaticResource MiniTextBox}"
                                     KeyDown="OnRgbBoxKeyDown" LostFocus="OnRgbBoxLostFocus" />
                        </Grid>

                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="B" VerticalAlignment="Center" Foreground="#3B82F6" />
                            <Slider x:Name="BSlider" Grid.Column="1" Minimum="0" Maximum="255"
                                    TickFrequency="1" ValueChanged="OnRgbSliderChanged" />
                            <TextBox x:Name="BBox" Grid.Column="2" Style="{StaticResource MiniTextBox}"
                                     KeyDown="OnRgbBoxKeyDown" LostFocus="OnRgbBoxLostFocus" />
                        </Grid>

                        <TextBlock Text="HSV" Margin="0,14,0,2" Style="{StaticResource Hint}" />

                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="H" VerticalAlignment="Center" Foreground="#8B5CF6" />
                            <Slider x:Name="HSlider" Grid.Column="1" Minimum="0" Maximum="360"
                                    TickFrequency="1" ValueChanged="OnHsvSliderChanged" />
                            <TextBox x:Name="HBox" Grid.Column="2" Style="{StaticResource MiniTextBox}"
                                     KeyDown="OnHsvBoxKeyDown" LostFocus="OnHsvBoxLostFocus" />
                        </Grid>

                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="S" VerticalAlignment="Center" Foreground="#8B5CF6" />
                            <Slider x:Name="SSlider" Grid.Column="1" Minimum="0" Maximum="100"
                                    TickFrequency="1" ValueChanged="OnHsvSliderChanged" />
                            <TextBox x:Name="SBox" Grid.Column="2" Style="{StaticResource MiniTextBox}"
                                     KeyDown="OnHsvBoxKeyDown" LostFocus="OnHsvBoxLostFocus" />
                        </Grid>

                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="V" VerticalAlignment="Center" Foreground="#8B5CF6" />
                            <Slider x:Name="VSlider" Grid.Column="1" Minimum="0" Maximum="100"
                                    TickFrequency="1" ValueChanged="OnHsvSliderChanged" />
                            <TextBox x:Name="VBox" Grid.Column="2" Style="{StaticResource MiniTextBox}"
                                     KeyDown="OnHsvBoxKeyDown" LostFocus="OnHsvBoxLostFocus" />
                        </Grid>

                        <TextBlock x:Name="ContrastText" Margin="0,14,0,0" Style="{StaticResource Hint}"
                                   TextWrapping="Wrap" />

                        <Button Content="加入收藏" Style="{StaticResource RoundedButton}"
                                Margin="0,12,0,0" Click="OnAddFavorite" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 中：色轮 + 色板 -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,14,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="配色" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondary}" Margin="0,0,8,0" />
                            <ComboBox x:Name="HarmonyCombo" Width="170" Height="30"
                                      DisplayMemberPath="Name"
                                      SelectionChanged="OnHarmonyChanged" />
                            <StackPanel x:Name="CustomAnglePanel" Orientation="Horizontal"
                                        Margin="10,0,0,0" Visibility="Collapsed">
                                <TextBlock Text="角度" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondary}" Margin="0,0,6,0" />
                                <TextBox x:Name="CustomAngleBox" Width="56" Height="30"
                                         Text="30" VerticalContentAlignment="Center" TextAlignment="Center"
                                         KeyDown="OnCustomAngleKeyDown" LostFocus="OnCustomAngleLostFocus" />
                                <TextBlock Text="°" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondary}" Margin="4,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <controls:ColorWheel x:Name="Wheel" Grid.Row="1" Margin="0,10"
                                         MinHeight="360" ColorPicked="OnWheelPicked" />

                    <StackPanel Grid.Row="2">
                        <Grid>
                            <TextBlock Text="色板 Color Palette" Style="{StaticResource SectionTitle}" Margin="0" />
                            <TextBlock Text="点击任意色块设为基色" HorizontalAlignment="Right"
                                       Style="{StaticResource Hint}" VerticalAlignment="Center" />
                        </Grid>
                        <controls:PaletteGrid x:Name="Palette" Height="110" Margin="0,8,0,0"
                                              ColorPicked="OnPalettePicked" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 右：配色列表与收藏 -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="3*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Matching Colors" Style="{StaticResource SectionTitle}" />

                    <ListBox x:Name="MatchingList" Grid.Row="1"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnMatchingSelected">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="6" CornerRadius="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="28" Height="28" CornerRadius="5"
                                                Background="{Binding Brush}"
                                                BorderBrush="#22000000" BorderThickness="1" />
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" FontSize="11"
                                                       Foreground="{StaticResource TextSecondary}" />
                                            <TextBlock Text="{Binding Hex}" FontFamily="Consolas"
                                                       FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Rgb}" FontSize="11"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="3" Content="⧉" FontSize="13"
                                                Tag="{Binding}" Click="OnCopyColorMenu"
                                                Style="{StaticResource GhostIconButton}"
                                                ToolTip="复制色值（HEX / RGB / HSL / CSS 变量）" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Grid.Row="2" Margin="0,12,0,6">
                        <TextBlock Text="Favorites" Style="{StaticResource SectionTitle}"
                                   VerticalAlignment="Center" Margin="0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="添加" Style="{StaticResource RoundedButton}"
                                    Padding="8,3" FontSize="11" Click="OnAddFavorite" Margin="0,0,6,0" />
                            <Button Content="移除" Style="{StaticResource RoundedButton}"
                                    Padding="8,3" FontSize="11" Click="OnRemoveFavorite" />
                        </StackPanel>
                    </Grid>

                    <ListBox x:Name="FavoritesList" Grid.Row="3"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnFavoriteSelected">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="6" CornerRadius="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="28" Height="28" CornerRadius="5"
                                                Background="{Binding Brush}"
                                                BorderBrush="#22000000" BorderThickness="1" />
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Hex}" FontFamily="Consolas"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Rgb}" FontSize="11"
                                                       Foreground="{StaticResource TextSecondary}" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="⧉" FontSize="13"
                                                Tag="{Binding}" Click="OnCopyColorMenu"
                                                Style="{StaticResource GhostIconButton}"
                                                ToolTip="复制色值（HEX / RGB / HSL / CSS 变量）" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
